function GitHubRequest(method, url, body) if not httpFn then
warn("[785Hub] No HTTP request fn — use Delta/Codex/Fluxus/Krnl, not plain Roblox") return nil end
local
ok, res = pcall(function() return httpFn({ Url = url, Method = method, Headers = { ["Authorization"] = "token " .. GITHUB_PAT, ["Accept"] = "application/vnd.github+json", ["Content-Type"] = "application/json", ["User-Agent"] = "785Hub", }, Body = body and HttpService:JSONEncode(body) or nil, }) end
