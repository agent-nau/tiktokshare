local
function parseEntry(e) if type(e) == "string" then
return e, "", "" end
if type(e) == "table" then
return e.key or "", e.note or "", e.created or "" end
return nil, "", "" end
local
function FetchGistKeys() local
res = GitHubRequest("GET", "https://api.github.com/gists/" .. GIST_ID) if not res or res.StatusCode ~= 200 then
fetchFailed = true;
return {} end
local
ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end
) if not ok or not data or not data.files or not data.files["keys.json"] then
fetchFailed = true;
return {} end
local
ok2, parsed = pcall(function() return HttpService:JSONDecode(data.files["keys.json"].content) end
) if not ok2 or not parsed then
fetchFailed = true;
return {} end
fetchFailed = false return parsed.keys or {} end
local
function FetchRemoteKeys() remoteKeys = FetchGistKeys() end
local
function PushKeyToGitHub(key, note) local
res = GitHubRequest("GET", "https://api.github.com/gists/" .. GIST_ID) if not res or res.StatusCode ~= 200 then
return false, "read failed" end
local
ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end
) if not ok or not data.files or not data.files["keys.json"] then
return false, "no keys.json in gist" end
local
ok2, parsed = pcall(function() return HttpService:JSONDecode(data.files["keys.json"].content) end
) if not ok2 or not parsed then
return false, "bad json in gist" end
parsed.keys = parsed.keys or {} table.insert(parsed.keys, { key = key, note = (note and note ~= "") and note or "(no note)", created = (os.date and os.date("!%Y-%m-%d %H:%M UTC")) or tostring(os.time()), }) local
patch = GitHubRequest("PATCH", "https://api.github.com/gists/" .. GIST_ID, { files = { ["keys.json"] = { content = HttpService:JSONEncode(parsed) } } }) return patch and patch.StatusCode == 200 end
local
function RevokeFromGitHub(key) local
res = GitHubRequest("GET", "https://api.github.com/gists/" .. GIST_ID) if not res or res.StatusCode ~= 200 then
return false, "read failed" end
local
ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end
) if not ok or not data.files or not data.files["keys.json"] then
return false, "no keys.json in gist" end
local
ok2, parsed = pcall(function() return HttpService:JSONDecode(data.files["keys.json"].content) end
) if not ok2 or not parsed then
return false, "bad json" end
local
kept, found = {}, false for _, e in ipairs(parsed.keys or {}) do local
k = parseEntry(e) if k == key then
found = true else table.insert(kept, e) end
end
if not found then
return false, "not in gist" end
parsed.keys = kept local
patch = GitHubRequest("PATCH", "https://api.github.com/gists/" .. GIST_ID, { files = { ["keys.json"] = { content = HttpService:JSONEncode(parsed) } } }) return patch and patch.StatusCode == 200 end
